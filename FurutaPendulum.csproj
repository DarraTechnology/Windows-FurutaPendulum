<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FurutaPendulum</RootNamespace>
    <AssemblyName>FurutaPendulum</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- net472 exe 在 Windows 上会被 SDK 推断成 RuntimeIdentifier=win7-x64，与
         Darra.EtherCAT.Master 的 win-x64 合同不符（构建前硬失败）。显式钉死 win-x64
         既过合同校验，也是包内 runtimes\win-x64 原生载荷解析的前提。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\x64\$(Configuration)\$(TargetFramework)\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- 版本口径唯一：<Version> / <AssemblyVersion> / <FileVersion> 与 PackageReference 同源。
         2.13.16 为 NuGet 公开版本。
         换版本时四处一起改，不保留案例版本例外。 -->
    <Version>2.13.16</Version>
    <AssemblyVersion>2.13.16.0</AssemblyVersion>
    <FileVersion>2.13.16.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Darra.EtherCAT.Master" Version="2.13.16" />
  </ItemGroup>
  <ItemGroup>
    <None Update="EtherCATRestore\放置GUI导出的config.deni到这里.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Update="EtherCATRestore\**\*.deni">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
